# MLflow tracking used by the training jobs (not by the Streamlit app).
# Local tracking (default when no server is used):
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Tracking server started with docker-compose:
# MLFLOW_TRACKING_URI=http://localhost:5000

# The Streamlit app reads joblib models from models/ (no MLflow needed).
# Defaults: models/best_model.pkl (churn) and models/best_clustering_model.pkl
# (segments). Override the exact paths if needed:
# CHURN_MODEL_PATH=models/best_model.pkl
# CLUSTERING_MODEL_PATH=models/best_clustering_model.pkl
